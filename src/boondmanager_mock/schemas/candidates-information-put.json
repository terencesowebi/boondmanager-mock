{
    "$schema": "http://json-schema.org/schema#",
    "description": "Candidate's information data sent in the body with a PUT method",
    "type": "object",
    "properties": {
        "data": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$",
                    "database": "TAB_PROFIL.ID_PROFIL"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "candidate"
                    ]
                },
                "attributes": {
                    "type": "object",
                    "properties": {
                        "creationDate": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$",
                            "database": "TAB_PROFIL.PROFIL_DATE"
                        },
                        "civility": {
                            "type": "integer",
                            "links": {
                                "rel": "describedBy",
                                "href": "/api/application/dictionary/setting.civility"
                            },
                            "database": "TAB_PROFIL.PROFIL_CIVILITE"
                        },
                        "firstName": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "database": "TAB_PROFIL.PROFIL_PRENOM"
                        },
                        "lastName": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "database": "TAB_PROFIL.PROFIL_NOM"
                        },
                        "title": {
                            "type": "string",
                            "maxLength": 150,
                            "database": "TAB_DT.DT_TITRE"
                        },
                        "state": {
                            "type": "integer",
                            "minimum": 0,
                            "links": {
                                "rel": "describedBy",
                                "href": "/api/application/dictionary/setting.state.candidat"
                            },
                            "database": "TAB_PROFIL.PROFIL_ETAT"
                        },
                        "stateReason": {
                            "type": "object",
                            "properties": {
                                "typeOf": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "database": "TAB_PROFIL.PROFIL_STATE_REASON"
                                },
                                "detail": {
                                    "type": "string",
                                    "database": "TAB_PROFIL.PROFIL_STATE_REASON_COMMENT"
                                }
                            }
                        },
                        "email1": {
                            "type": "string",
                            "maxLength": 100,
                            "database": "TAB_PROFIL.PROFIL_EMAIL"
                        },
                        "email2": {
                            "type": "string",
                            "maxLength": 100,
                            "database": "TAB_PROFIL.PROFIL_EMAIL2"
                        },
                        "email3": {
                            "type": "string",
                            "maxLength": 100,
                            "database": "TAB_PROFIL.PROFIL_EMAIL3"
                        },
                        "phone1": {
                            "type": "string",
                            "maxLength": 20,
                            "database": "TAB_PROFIL.PROFIL_TEL1"
                        },
                        "phone2": {
                            "type": "string",
                            "maxLength": 20,
                            "database": "TAB_PROFIL.PROFIL_TEL2"
                        },
                        "phone3": {
                            "type": "string",
                            "maxLength": 20,
                            "database": "TAB_PROFIL.PROFIL_TEL3"
                        },
                        "fax": {
                            "type": "string",
                            "maxLength": 20,
                            "database": "TAB_PROFIL.PROFIL_FAX"
                        },
                        "address": {
                            "description": "/!\\ Deprecated in information. Use administrative tab instead",
                            "type": "string",
                            "maxLength": 250,
                            "database": "TAB_PROFIL.PROFIL_ADR"
                        },
                        "postcode": {
                            "type": "string",
                            "maxLength": 10,
                            "database": "TAB_PROFIL.PROFIL_CP"
                        },
                        "town": {
                            "type": "string",
                            "maxLength": 100,
                            "database": "TAB_PROFIL.PROFIL_VILLE"
                        },
                        "country": {
                            "type": "string",
                            "maxLength": 100,
                            "links": {
                                "rel": "describedBy",
                                "href": "/api/application/dictionary/country"
                            },
                            "database": "TAB_PROFIL.PROFIL_PAYS"
                        },
                        "subDivision": {
                            "type": "string",
                            "maxLength": 6,
                            "database": "TAB_PROFIL.PROFIL_SUBDIVISION"
                        },
                        "source": {
                            "type": "object",
                            "properties": {
                                "typeOf": {
                                    "type": "integer",
                                    "minimum": -1,
                                    "links": {
                                        "rel": "describedBy",
                                        "href": "/api/application/dictionary/setting.source"
                                    },
                                    "database": "TAB_PROFIL.PARAM_TYPESOURCE"
                                },
                                "detail": {
                                    "type": "string",
                                    "maxLength": 100,
                                    "database": "TAB_PROFIL.PARAM_SOURCE"
                                }
                            },
                            "required": [
                                "typeOf",
                                "detail"
                            ],
                            "additionalProperties": false
                        },
                        "dateOfBirth": {
                            "type": "string",
                            "pattern": "^|[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                            "database": "TAB_PROFIL.PROFIL_DATENAISSANCE"
                        },
                        "mobilityAreas": {
                            "description": "List of mobilities {id}",
                            "type": "array",
                            "items": {
                                "type": "string",
                                "links": {
                                    "rel": "describedBy",
                                    "href": "/api/application/dictionary/setting.mobilityArea"
                                }
                            },
                            "database": "TAB_PROFIL.PARAM_MOBILITE"
                        },
                        "globalEvaluation": {
                            "type": "string",
                            "maxLength": 100,
                            "links": {
                                "rel": "describedBy",
                                "href": "/api/application/dictionary/setting.evaluation"
                            },
                            "database": "TAB_PROFIL.PROFIL_STATUT"
                        },
                        "evaluations": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    {
                                        "description": "Create an evaluation",
                                        "type": "object",
                                        "properties": {
                                            "notations": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "criteria": {
                                                            "type": "integer",
                                                            "minimum": 0,
                                                            "links": {
                                                                "rel": "describedBy",
                                                                "href": "/api/application/dictionary/setting.criteria"
                                                            }
                                                        },
                                                        "evaluation": {
                                                            "type": "string",
                                                            "maxLength": 100,
                                                            "links": {
                                                                "rel": "describedBy",
                                                                "href": "/api/application/dictionary/setting.evaluation"
                                                            }
                                                        }
                                                    },
                                                    "required": [
                                                        "criteria",
                                                        "evaluation"
                                                    ],
                                                    "additionalProperties": false
                                                },
                                                "uniqueItems": true,
                                                "database": "TAB_NOTATION.NOTATION_NOTES"
                                            },
                                            "date": {
                                                "type": "string",
                                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                                                "database": "TAB_NOTATION.NOTATION_DATE"
                                            },
                                            "comments": {
                                                "type": "string",
                                                "maxLength": 250,
                                                "database": "TAB_NOTATION.NOTATION_COMMENTAIRE"
                                            }
                                        },
                                        "required": [
                                            "notations",
                                            "date",
                                            "comments"
                                        ],
                                        "additionalProperties": false
                                    },
                                    {
                                        "description": "Update an evaluation",
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "pattern": "^[1-9][0-9]*$",
                                                "database": "TAB_NOTATION.ID_NOTATION"
                                            },
                                            "notations": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "criteria": {
                                                            "type": "integer",
                                                            "minimum": 0,
                                                            "links": {
                                                                "rel": "describedBy",
                                                                "href": "/api/application/dictionary/setting.criteria"
                                                            }
                                                        },
                                                        "evaluation": {
                                                            "type": "string",
                                                            "maxLength": 100,
                                                            "links": {
                                                                "rel": "describedBy",
                                                                "href": "/api/application/dictionary/setting.evaluation"
                                                            }
                                                        }
                                                    },
                                                    "required": [
                                                        "criteria",
                                                        "evaluation"
                                                    ],
                                                    "additionalProperties": false
                                                },
                                                "uniqueItems": true,
                                                "database": "TAB_NOTATION.NOTATION_NOTES"
                                            },
                                            "date": {
                                                "type": "string",
                                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                                                "database": "TAB_NOTATION.NOTATION_DATE"
                                            },
                                            "comments": {
                                                "type": "string",
                                                "maxLength": 250,
                                                "database": "TAB_NOTATION.NOTATION_COMMENTAIRE"
                                            }
                                        },
                                        "required": [
                                            "id",
                                            "notations",
                                            "date",
                                            "comments"
                                        ],
                                        "additionalProperties": false
                                    }
                                ]
                            }
                        },
                        "availability": {
                            "type": [
                                "integer",
                                "string"
                            ],
                            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
                            "links": {
                                "rel": "describedBy",
                                "href": "/api/application/dictionary/setting.availability"
                            },
                            "database": "TAB_PROFIL.PARAM_TYPEDISPO, TAB_PROFIL.PARAM_DATEDISPO"
                        },
                        "isVisible": {
                            "type": "boolean",
                            "database": "TAB_PROFIL.PROFIL_VISIBILITE"
                        },
                        "informationComments": {
                            "type": "string",
                            "maxLength": 1000,
                            "database": "TAB_PROFIL.PARAM_COMMENTAIRE"
                        },
                        "socialNetworks": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "network": {
                                        "type": "string",
                                        "enum": [
                                            "facebook",
                                            "viadeo",
                                            "linkedin",
                                            "x"
                                        ],
                                        "database": "TAB_WEBSOCIAL.WEBSOCIAL_NETWORK"
                                    },
                                    "url": {
                                        "type": "string",
                                        "maxLength": 250,
                                        "database": "TAB_WEBSOCIAL.WEBSOCIAL_URL"
                                    }
                                },
                                "required": [
                                    "network",
                                    "url"
                                ],
                                "additionalProperties": false
                            },
                            "uniqueItems": true,
                            "minItems": 0,
                            "maxItems": 4
                        },
                        "importResumes": {
                            "type": "boolean",
                            "description": "true to copy resumes to the new resource, depends on `state`"
                        },
                        "importFiles": {
                            "type": "boolean",
                            "description": "true to copy files to the new resource, depends on `state`"
                        },
                        "importContractFiles": {
                            "type": "boolean",
                            "description": "true to copy contract file to the new resource, depends on `state`"
                        },
                        "importContract": {
                            "type": "boolean",
                            "description": "true to import candidate's contract into the updated resource when candidate is hired again"
                        },
                        "importFields": {
                            "type": "array",
                            "description": "list of resource's fields to update from candidate when candidate is hired again"
                        }
                    },
                    "additionalProperties": false
                },
                "relationships": {
                    "type": "object",
                    "properties": {
                        "mainManager": {
                            "description": "Candidate's main manager",
                            "type": "object",
                            "properties": {
                                "data": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "pattern": "^[1-9][0-9]*$",
                                            "database": "TAB_PROFIL.ID_RESPMANAGER"
                                        },
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "resource"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "type"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "required": [
                                "data"
                            ],
                            "additionalProperties": false
                        },
                        "hrManager": {
                            "oneOf": [
                                {
                                    "description": "No relationships",
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "null"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ],
                                    "additionalProperties": false
                                },
                                {
                                    "description": "Candidate's hr manager",
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "pattern": "^[1-9][0-9]*$",
                                                    "database": "TAB_PROFIL.ID_RESPRH"
                                                },
                                                "type": {
                                                    "type": "string",
                                                    "enum": [
                                                        "resource"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "type"
                                            ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ],
                                    "additionalProperties": false
                                }
                            ]
                        },
                        "agency": {
                            "description": "Candidate's agency",
                            "type": "object",
                            "properties": {
                                "data": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "pattern": "^[1-9][0-9]*$",
                                            "database": "TAB_PROFIL.ID_SOCIETE"
                                        },
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "agency"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "type"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "required": [
                                "data"
                            ],
                            "additionalProperties": false
                        },
                        "pole": {
                            "oneOf": [
                                {
                                    "description": "No relationships",
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "null"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ],
                                    "additionalProperties": false
                                },
                                {
                                    "description": "Candidate's pole",
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string",
                                                    "pattern": "^[1-9][0-9]*$",
                                                    "database": "TAB_PROFIL.ID_POLE"
                                                },
                                                "type": {
                                                    "type": "string",
                                                    "enum": [
                                                        "pole"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "type"
                                            ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ],
                                    "additionalProperties": false
                                }
                            ]
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "type"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "data"
    ],
    "additionalProperties": false,
    "id": "schemas/candidates/informationBodyPut.json"
}